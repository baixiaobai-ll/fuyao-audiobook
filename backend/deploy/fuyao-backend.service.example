[Unit]
Description=Fuyao Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/fuyao-backend/current
Environment=FUYAO_ENV_FILE=/opt/fuyao-backend/shared/backend.env
Environment=FUYAO_ENVIRONMENT=production
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m backend.main serve --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3
User=fuyao
Group=fuyao
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/fuyao-backend/shared
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
