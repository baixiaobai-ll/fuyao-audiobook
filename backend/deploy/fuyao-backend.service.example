[Unit]
Description=Fuyao Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/fuyao-backend/current
Environment=FUYAO_ENV_FILE=/opt/fuyao-backend/shared/backend.env
ExecStart=/usr/bin/python3 -m backend.main serve --host 0.0.0.0 --port 8787
Restart=always
RestartSec=3
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
