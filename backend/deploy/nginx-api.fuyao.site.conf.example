server {
    listen 80;
    listen [::]:80;
    server_name api.fuyao.site;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.fuyao.site;

    ssl_certificate /etc/letsencrypt/live/api.fuyao.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.fuyao.site/privkey.pem;

    client_max_body_size 10m;

    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer-when-downgrade always;

    location /legal/ {
        alias /opt/fuyao-backend/current/backend/static/legal/;
        try_files $uri $uri.html =404;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
