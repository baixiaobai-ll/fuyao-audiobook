# Core server
FUYAO_BACKEND_HOST=0.0.0.0
FUYAO_BACKEND_PORT=8787
FUYAO_BACKEND_DB=/opt/fuyao-backend/shared/fuyao.sqlite3
FUYAO_TIMEZONE=Asia/Shanghai
FUYAO_SESSION_TTL_DAYS=30
FUYAO_DAILY_CHAPTER_LIMIT=10

# One-click login main flow: mock or aliyun
FUYAO_ONE_CLICK_PROVIDER=aliyun
FUYAO_ONE_CLICK_MOCK_PHONE=13800138000

# SMS provider: mock or aliyun
FUYAO_SMS_PROVIDER=mock
FUYAO_SMS_CODE_TTL_SECONDS=300
FUYAO_SMS_RESEND_SECONDS=60
FUYAO_SMS_MOCK_CODE=123456

# Aliyun PNVS / One-click login
FUYAO_ALIYUN_ACCESS_KEY_ID=
FUYAO_ALIYUN_ACCESS_KEY_SECRET=
FUYAO_ALIYUN_REGION_ID=cn-hangzhou
FUYAO_ALIYUN_ENDPOINT=https://dypnsapi.aliyuncs.com

# Client-side number-auth SDK data (documented here for deployment handoff; backend does not call them directly)
FUYAO_ALIYUN_NUMBER_AUTH_SCHEME_CODE=
FUYAO_ALIYUN_NUMBER_AUTH_SDK_INFO=

# Optional SMS fallback
FUYAO_ALIYUN_COUNTRY_CODE=86
FUYAO_ALIYUN_SCHEME_NAME=
FUYAO_ALIYUN_SMS_SIGN_NAME=
FUYAO_ALIYUN_SMS_TEMPLATE_CODE=
FUYAO_ALIYUN_SMS_TEMPLATE_PARAM_CODE_KEY=code
FUYAO_ALIYUN_SMS_TEMPLATE_PARAM_MINUTES_KEY=min
FUYAO_ALIYUN_SMS_TEMPLATE_EXTRA_PARAMS={}
FUYAO_ALIYUN_SMS_CODE_LENGTH=6
FUYAO_ALIYUN_SMS_CODE_TYPE=1
FUYAO_ALIYUN_SMS_INTERVAL_SECONDS=60
FUYAO_ALIYUN_SMS_DUPLICATE_POLICY=1
FUYAO_ALIYUN_SMS_VALIDITY_SECONDS=300
FUYAO_ALIYUN_SMS_AUTO_RETRY=1
FUYAO_ALIYUN_SMS_RETURN_VERIFY_CODE=false
FUYAO_ALIYUN_HTTP_TIMEOUT_SECONDS=10
