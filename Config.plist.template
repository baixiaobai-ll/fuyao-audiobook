<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ==================== -->
    <!-- API 密钥配置 -->
    <!-- ==================== -->

    <!-- AI 分析服务 API 密钥 -->
    <!-- 获取方式: Moonshot Kimi 开放平台 https://platform.moonshot.cn/ -->
    <!-- 也可用专用键名 KIMI_API_KEY / MOONSHOT_API_KEY 覆盖（优先级高于 AI_API_KEY） -->
    <key>AI_API_KEY</key>
    <string>your-kimi-api-key-here</string>

    <!-- TTS 服务 API 密钥 -->
    <!-- Azure: https://portal.azure.com/ (创建语音服务资源) -->
    <!-- 科大讯飞: https://console.xfyun.cn/ (格式: appid:apisecret:apikey) -->
    <key>TTS_API_KEY</key>
    <string>your-tts-api-key-here</string>

    <!-- ==================== -->
    <!-- 服务提供商配置 -->
    <!-- ==================== -->

    <!-- AI 服务提供商: 默认 kimi（Moonshot Kimi K2.6），可选 qwen -->
    <key>AI_PROVIDER</key>
    <string>kimi</string>

    <!-- TTS 服务提供商: azure, xfyun, openai -->
    <key>TTS_PROVIDER</key>
    <string>xfyun</string>

    <!-- Azure 区域 (仅 Azure TTS 需要) -->
    <!-- 可选值: eastasia, southeastasia, eastus, westus 等 -->
    <key>AZURE_REGION</key>
    <string>eastasia</string>

    <!-- ==================== -->
    <!-- 可选配置 -->
    <!-- ==================== -->

    <!-- 文本分析默认走 Kimi K2.6（api.moonshot.cn），如需切 Qwen 把 AI_PROVIDER 改成 qwen 即可 -->

    <!-- ==================== -->
    <!-- 号码认证配置 -->
    <!-- ==================== -->

    <!-- 可选：自行部署的认证服务根地址。原项目线上服务已停用，请勿直接使用示例域名。 -->
    <key>AUTH_API_BASE_URL</key>
    <string>https://api.example.com</string>

    <!-- 阿里云号码认证 SDK 鉴权串，建议在真机环境下填写正式值 -->
    <key>NUMBER_AUTH_SDK_INFO</key>
    <string>your-number-auth-sdk-info</string>
</dict>
</plist>
