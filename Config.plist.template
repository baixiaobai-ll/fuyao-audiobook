<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ==================== -->
    <!-- API 密钥配置 -->
    <!-- ==================== -->

    <!-- AI 分析服务 API 密钥 -->
    <!-- 获取方式: 阿里云 DashScope / 通义千问控制台 -->
    <key>AI_API_KEY</key>
    <string>your-qwen-api-key-here</string>

    <!-- TTS 服务 API 密钥 -->
    <!-- Azure: https://portal.azure.com/ (创建语音服务资源) -->
    <!-- 科大讯飞: https://console.xfyun.cn/ (格式: appid:apisecret:apikey) -->
    <key>TTS_API_KEY</key>
    <string>your-tts-api-key-here</string>

    <!-- ==================== -->
    <!-- 服务提供商配置 -->
    <!-- ==================== -->

    <!-- AI 服务提供商: 固定为 qwen -->
    <key>AI_PROVIDER</key>
    <string>qwen</string>

    <!-- TTS 服务提供商: azure, xfyun, openai -->
    <key>TTS_PROVIDER</key>
    <string>xfyun</string>

    <!-- Azure 区域 (仅 Azure TTS 需要) -->
    <!-- 可选值: eastasia, southeastasia, eastus, westus 等 -->
    <key>AZURE_REGION</key>
    <string>eastasia</string>

    <!-- ==================== -->
    <!-- 可选配置 -->
    <!-- ==================== -->

    <!-- 文本分析当前固定走通义千问，无需额外 Base URL 配置 -->
</dict>
</plist>
